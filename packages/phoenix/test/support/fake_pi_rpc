#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"

session_number = 1
reset_behavior = :accept

$stdin.each_line do |line|
  command = JSON.parse(line)

  case command.fetch("type")
  when "get_state"
    puts JSON.generate(
      type: "response",
      id: command.fetch("id"),
      success: true,
      data: {
        sessionId: "fixture-session-#{session_number}",
        model: {provider: "test", id: "fake-pi"}
      }
    )
  when "prompt"
    reset_behavior = :reject if command.fetch("message").include?("reject reset")
    reset_behavior = :fail if command.fetch("message").include?("fail reset")

    if command.fetch("message").include?("stale response")
      puts JSON.generate(type: "response", id: "task-stale-command", success: false)
    end

    puts JSON.generate(type: "response", id: command.fetch("id"), success: true)
    puts JSON.generate(type: "agent_start")

    if command.fetch("message").include?("oversized record")
      puts("x" * 1_000_001)
      next
    end

    if command.fetch("message").include?("malformed record")
      puts("{not-json")
      puts JSON.generate(type: "agent_settled")
      $stdout.flush
      next
    end

    if command.fetch("message").include?("non-object record")
      puts("null")
      $stdout.flush
      next
    end

    puts JSON.generate(
      type: "message_update",
      assistantMessageEvent: {
        type: "text_delta",
        delta: "Implemented the whole-page request."
      }
    )
    puts JSON.generate(type: "agent_settled") unless command.fetch("message").include?("hold this task")
  when "abort"
    puts JSON.generate(type: "response", id: command.fetch("id"), success: true)
    $stdout.flush
    sleep 0.2
    puts JSON.generate(type: "agent_settled")
  when "new_session"
    sleep 0.05
    if reset_behavior == :fail
      puts JSON.generate(type: "response", id: command.fetch("id"), success: false, error: "fixture reset failure")
    else
      cancelled = reset_behavior == :reject
      session_number += 1 unless cancelled
      puts JSON.generate(type: "response", id: command.fetch("id"), success: true, data: {cancelled: cancelled})
    end
  end

  $stdout.flush
end
