{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-browser-taskbar.dev/contract/schemas/rpc-transcript.v1.schema.json",
  "title": "Pi RPC transcript v1",
  "type": "object",
  "required": ["contract_version", "name", "steps"],
  "properties": {
    "contract_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["direction", "message"],
        "properties": {
          "direction": {"type": "string", "enum": ["receive", "send"]},
          "message": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
