{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-browser-taskbar.dev/contract/schemas/browser-context.v1.schema.json",
  "title": "Normalized browser context v1",
  "type": "object",
  "x-maxJsonUtf8Bytes": 98304,
  "required": ["contract_version", "location", "route", "snapshot", "focus_points", "truncation"],
  "properties": {
    "contract_version": {"const": 1},
    "location": {"$ref": "#/$defs/location"},
    "route": {
      "type": ["object", "null"],
      "required": ["method", "pattern", "handler", "action"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 16, "x-maxUtf8Bytes": 16, "pattern": "^[A-Z]+$"},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 1000, "x-maxUtf8Bytes": 1000},
        "handler": {"type": "string", "minLength": 1, "maxLength": 500, "x-maxUtf8Bytes": 500},
        "action": {"type": ["string", "null"], "maxLength": 256, "x-maxUtf8Bytes": 256}
      },
      "additionalProperties": false
    },
    "snapshot": {
      "$ref": "#/$defs/node",
      "x-maxJsonUtf8Bytes": 49152,
      "x-maxNodes": 750,
      "x-maxDepth": 12
    },
    "focus_points": {
      "type": "array",
      "maxItems": 8,
      "x-maxJsonUtf8Bytes": 49152,
      "x-uniqueBy": "selector",
      "items": {"$ref": "#/$defs/focusPoint"}
    },
    "truncation": {
      "type": "array",
      "items": {"$ref": "#/$defs/truncation"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "required": ["origin", "path", "query_names"],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxUtf8Bytes": 512,
          "x-httpOrigin": true,
          "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+)(?::[0-9]{1,5})?$"
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048, "pattern": "^/[^?#]*$"},
        "query_names": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128}
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["tag", "children"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "maxLength": 64, "x-maxUtf8Bytes": 64, "pattern": "^[a-z][a-z0-9-]*$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 64, "x-maxUtf8Bytes": 64},
        "name": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512},
        "text": {"type": "string", "maxLength": 1000, "x-maxUtf8Bytes": 1000},
        "id": {"type": "string", "maxLength": 256, "x-maxUtf8Bytes": 256},
        "classes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128}
        },
        "attributes": {"$ref": "#/$defs/attributes"},
        "state": {"$ref": "#/$defs/state"},
        "href": {"$ref": "#/$defs/location"},
        "src": {"$ref": "#/$defs/location"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "type": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "placeholder": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "data-testid": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "disabled": {"type": "boolean"},
        "checked": {"type": ["boolean", "string"], "enum": [true, false, "mixed"]},
        "selected": {"type": "boolean"},
        "expanded": {"type": "boolean"},
        "pressed": {"type": ["boolean", "string"], "enum": [true, false, "mixed"]},
        "required": {"type": "boolean"},
        "invalid": {"type": ["boolean", "string"], "enum": [true, false, "grammar", "spelling"]}
      },
      "additionalProperties": false
    },
    "nodeSummary": {
      "type": "object",
      "required": ["tag"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "maxLength": 64, "x-maxUtf8Bytes": 64, "pattern": "^[a-z][a-z0-9-]*$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 64, "x-maxUtf8Bytes": 64},
        "name": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512},
        "id": {"type": "string", "maxLength": 256, "x-maxUtf8Bytes": 256}
      },
      "additionalProperties": false
    },
    "focusPoint": {
      "type": "object",
      "required": ["selector", "source_status", "ancestors", "subtree"],
      "properties": {
        "selector": {"type": "string", "minLength": 1, "maxLength": 1000, "x-maxUtf8Bytes": 1000},
        "source_status": {
          "type": "string",
          "enum": ["available", "ambiguous", "external", "unavailable"]
        },
        "ancestors": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/nodeSummary"}
        },
        "subtree": {"$ref": "#/$defs/node", "x-maxNodes": 100, "x-maxDepth": 6}
      },
      "additionalProperties": false
    },
    "truncation": {
      "type": "object",
      "required": ["section", "reasons"],
      "properties": {
        "section": {"type": "string", "pattern": "^(page|focus:[1-8])$"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["bytes", "nodes", "depth", "string"]}
        }
      },
      "additionalProperties": false
    }
  }
}
