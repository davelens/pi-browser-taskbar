{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-browser-taskbar.dev/contract/schemas/fixture-manifest.v1.schema.json",
  "title": "Contract fixture manifest v1",
  "type": "object",
  "required": ["contract_version", "fixtures"],
  "properties": {
    "contract_version": {"const": 1},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "schema", "path", "expected_valid"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "schema": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^fixtures/"},
          "expected_valid": {"type": "boolean"},
          "error_contains": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
