#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

printf '%s\n' '==> Validate shell entry points'
bash -n bin/build bin/verify tooling/build_packages.sh tooling/test/phoenix_clean_app_conformance.sh tooling/test/rails_clean_app_conformance.sh

printf '%s\n' '==> Validate executable contracts'
ruby tooling/contract_validator.rb
ruby -Itooling/test tooling/test/fake_pi_rpc_test.rb

printf '%s\n' '==> Enforce ownership, version, and documentation boundaries'
ruby tooling/verify_architecture.rb
ruby tooling/stage_shared_docs.rb --check
ruby tooling/verify_documentation.rb

printf '%s\n' '==> Check generated Browser Client assets'
node tooling/build_browser_assets.mjs --check
node --test tooling/test/browser_assets_test.mjs
node tooling/test/current_browser_test.mjs

printf '%s\n' '==> Install native adapter test dependencies'
rails_version=${PI_BROWSER_TASKBAR_TEST_RAILS_VERSION:-8.1.3}
export PI_BROWSER_TASKBAR_TEST_RAILS_VERSION="$rails_version"
if ! ruby -e 'gem "rails", ARGV.fetch(0); require "rails"' "$rails_version" 2>/dev/null; then
  gem install rails --version "$rails_version" --no-document
fi
(
  cd packages/phoenix
  mix deps.get --only test
)

printf '%s\n' '==> Run native adapter package tests'
ruby packages/rails/test/package_test.rb
(
  cd packages/phoenix
  mix format --check-formatted
  mix test --warnings-as-errors
)

printf '%s\n' '==> Build and inspect ecosystem artifacts'
tooling/build_packages.sh
ruby tooling/verify_artifacts.rb

printf '%s\n' '==> Run packaged Rails clean-application conformance'
tooling/test/rails_clean_app_conformance.sh

printf '%s\n' '==> Run packaged Phoenix clean-application conformance'
tooling/test/phoenix_clean_app_conformance.sh

printf '%s\n' '==> Compare packaged adapter semantics'
ruby tooling/test/compare_adapter_semantics_test.rb
ruby tooling/test/compare_adapter_semantics.rb

printf '%s\n' 'verification passed'
